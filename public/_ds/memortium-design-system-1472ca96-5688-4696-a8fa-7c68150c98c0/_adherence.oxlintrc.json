      {
        "selector": "JSXOpeningElement[name.name='PortraitFigure'] > JSXAttribute[name.name='originalOrientation'] > Literal[value!=/^(?:portrait|landscape)$/]",
        "message": "<PortraitFigure> originalOrientation must be one of 'portrait' | 'landscape'."
