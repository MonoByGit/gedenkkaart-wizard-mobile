        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|pageCount|total|itemLabel|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, pageCount, total, itemLabel, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PortraitFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:edited|original|caption|originalOrientation|style|key|ref|className|style|children)$/]",
        "message": "<PortraitFigure> doesn't accept that prop. Declared props: edited, original, caption, originalOrientation, style."
